# ==============================================================================
# Ananya ERP — Production Docker Ignore
# Exclude unnecessary build context to optimize build speed and security
# ==============================================================================

# Version control
.git
.gitignore
.github

# Dependencies & local node_modules
**/node_modules

# Build outputs & artifacts
**/dist
**/.next
**/out
**/coverage
**/test-results
**/playwright-report

# Editor & IDE files
.vscode
.idea
.DS_Store
*.swp
*.swo

# Environment variables & local secrets
.env
.env.*
!.env.example

# Logs & temporary files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
tmp
temp
.turbo
