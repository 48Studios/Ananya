{
  "name": "ananya",
  "description": "Internal operations system for 48 Studios.",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "node --env-file-if-exists=.env ./node_modules/turbo/bin/turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "db:generate": "pnpm --filter @ananya/database db:generate",
    "db:push": "pnpm --filter @ananya/database db:push",
    "db:migrate": "pnpm --filter @ananya/database db:migrate",
    "db:setup": "pnpm --filter @ananya/database db:setup",
    "db:bootstrap": "pnpm --filter @ananya/database db:bootstrap",
    "seed:spatial": "node tools/spatial-demo-dataset/seed.mjs",
    "seed:spatial:verify": "node tools/spatial-demo-dataset/verify.mjs",
    "seed:spatial:reset": "node tools/spatial-demo-dataset/cleanup.mjs --execute",
    "diagnose:location-hierarchy": "node tools/spatial-integrity/diagnose-location-hierarchy.mjs",
    "preview:physical-container-backfill": "node tools/spatial-integrity/preview-physical-container-backfill.mjs",
    "backfill:physical-containment": "node --env-file-if-exists=.env tools/spatial-integrity/backfill-physical-containment.mjs",
    "verify:physical-containment": "node tools/spatial-integrity/verify-physical-containment.mjs",
    "ml:setup": "python3 -m venv apps/ml/.venv && ./apps/ml/.venv/bin/pip install -r apps/ml/requirements.txt",
    "ml:dev": "./apps/ml/.venv/bin/uvicorn apps.ml.app.main:app --host 0.0.0.0 --port 5001 --reload",
    "test": "turbo run test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:update-snapshots": "playwright test --update-snapshots",
    "test:accessibility": "playwright test tests/accessibility",
    "test:visual": "playwright test tests/e2e/visual-regression.spec.ts",
    "qa": "pnpm lint && pnpm check-types && pnpm test && pnpm build && pnpm test:e2e"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.50.1",
    "drizzle-kit": "^0.31.0",
    "prettier": "^3.7.4",
    "turbo": "^2.11.2",
    "typescript": "5.9.2",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "pnpm": {
    "overrides": {
      "esbuild@<=0.24.2": ">=0.25.0",
      "fast-uri@>=3.0.0 <=3.1.3": ">=3.1.4",
      "brace-expansion@<1.1.17": ">=1.1.17",
      "brace-expansion@>=2.0.0 <2.1.3": ">=2.1.3",
      "brace-expansion@>=4.0.0 <5.0.8": ">=5.0.8",
      "fast-uri@>=3.0.0 <3.1.5": ">=3.1.5",
      "hono@<4.12.34": ">=4.12.34",
      "brace-expansion@>=4.0.0 <5.0.9": ">=5.0.9",
      "brace-expansion@>=2.0.0 <2.1.4": ">=2.1.4",
      "brace-expansion@<1.1.18": ">=1.1.18",
      "minimatch@3.1.5>brace-expansion": "1.1.18",
      "js-yaml@>=3.0.0 <3.15.1": ">=3.15.1",
      "js-yaml@>=4.0.0 <4.3.1": ">=4.3.1",
      "hono@>=3.8.0 <4.12.34": ">=4.12.34",
      "hono@>=4.7.0 <4.12.34": ">=4.12.34",
      "hono@>=4.12.0 <4.12.34": ">=4.12.34",
      "browserslist@<=4.28.6": ">=4.28.7",
      "qs@>=6.14.2 <=6.15.3": ">=6.16.0",
      "qs@>=2.2.5 <6.16.0": ">=6.16.0",
      "fast-uri@>=3.1.3 <3.1.6": ">=3.1.6",
      "fast-uri@>=3.0.0 <3.1.6": ">=3.1.6",
      "fast-uri@>=3.1.2 <3.1.6": ">=3.1.6",
      "js-yaml@>=3.0.0 <3.15.2": ">=3.15.2",
      "js-yaml@>=4.0.0 <4.3.2": ">=4.3.2",
      "hono@<4.13.5": ">=4.13.5",
      "undici@>=7.28.0 <7.29.1": ">=7.29.1",
      "fast-uri@>=3.0.0 <3.1.7": ">=3.1.7",
      "ip-address@<=10.5.0": ">=10.5.1",
      "ip-address@>=10.2.0 <=10.5.0": ">=10.5.1"
    }
  }
}
