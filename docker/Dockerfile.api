# ==============================================================================
# Ananya ERP — Production API Container Image
# Multi-stage Dockerfile using pnpm and Turborepo prune
# ==============================================================================

# ------------------------------------------------------------------------------
# Stage 1: Pruner
# Prune the monorepo workspace for @ananya/api
# ------------------------------------------------------------------------------
FROM node:20-alpine AS pruner
RUN apk add --no-cache libc6-compat
WORKDIR /app
RUN npm install -g pnpm@9.0.0 turbo@^2.10.5
COPY . .
RUN turbo prune --scope=@ananya/api --docker

# ------------------------------------------------------------------------------
# Stage 2: Builder
# Install dependencies and build production artifacts
# ------------------------------------------------------------------------------
FROM node:20-alpine AS builder
RUN apk add --no-cache libc6-compat
WORKDIR /app
RUN npm install -g pnpm@9.0.0

# Copy pruned lockfile & workspace package configs
COPY --from=pruner /app/out/json/ .
COPY --from=pruner /app/out/pnpm-lock.yaml ./pnpm-lock.yaml

# Install all dependencies (including devDependencies for compilation)
RUN pnpm install --frozen-lockfile

# Copy pruned source code
COPY --from=pruner /app/out/full/ .

# Build workspace packages & API
ENV NODE_ENV=production
RUN pnpm turbo run build --filter=@ananya/api...

# ------------------------------------------------------------------------------
# Stage 3: Production Runner
# Minimal runtime environment with non-root security isolation
# ------------------------------------------------------------------------------
FROM node:20-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=4000

# Create non-root system user & group
RUN addgroup -S -g 10001 ananya && \
    adduser -S -u 10001 -G ananya ananya

# Enable pnpm for runtime scripts
RUN npm install -g pnpm@9.0.0

# Copy pruned package json & lockfile for production dependency installation
COPY --from=pruner /app/out/json/ .
COPY --from=pruner /app/out/pnpm-lock.yaml ./pnpm-lock.yaml
RUN pnpm install --frozen-lockfile --prod

# Copy built artifacts from builder
COPY --from=builder /app/apps/api/dist ./apps/api/dist
COPY --from=builder /app/packages ./packages

# Set correct permissions
RUN chown -R ananya:ananya /app

# Switch to non-root user
USER ananya

EXPOSE 4000

# Health check probe
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://localhost:4000/health').then(r=>r.ok?process.exit(0):process.exit(1)).catch(()=>process.exit(1))"

CMD ["node", "apps/api/dist/main.js"]
