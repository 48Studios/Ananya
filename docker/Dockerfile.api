# ==============================================================================
# Ananya ERP — Production API Container Image
# Hardened Multi-stage Dockerfile (Pruner -> Builder -> Prod-Deps -> Runner)
# ==============================================================================

# ------------------------------------------------------------------------------
# Stage 1: Pruner
# Prune the monorepo workspace for @ananya/api
# ------------------------------------------------------------------------------
FROM node:22-alpine AS pruner
RUN apk add --no-cache libc6-compat
WORKDIR /app
RUN corepack enable
COPY . .
RUN npx turbo prune --scope=@ananya/api --docker

# ------------------------------------------------------------------------------
# Stage 2: Builder
# Install dependencies and build production artifacts
# ------------------------------------------------------------------------------
FROM node:22-alpine AS builder
RUN apk add --no-cache libc6-compat
WORKDIR /app
RUN corepack enable

# Copy pruned lockfile & workspace package configs
COPY --from=pruner /app/out/json/ .
COPY --from=pruner /app/out/pnpm-lock.yaml ./pnpm-lock.yaml

# Install all dependencies with BuildKit caching
RUN --mount=type=cache,id=pnpm,target=/root/.local/share/pnpm/store \
    pnpm install

# Copy pruned source code
COPY --from=pruner /app/out/full/ .

# Build workspace packages & API
ENV NODE_ENV=production
RUN pnpm turbo run build --filter=@ananya/api...

# Bake the migration identity (Phases 3.4.11–3.4.12/D1): binds this image to
# the source revision and release version it was built from, so setup.sh can
# verify artifact-only upgrades against the intended release instead of
# trusting a mutable image tag. GIT_SHA/RELEASE_VERSION arrive as build args
# from CI (release.yml / docker.yml); local builds record "unknown" and fail
# closed in artifact-only mode, which is the safe direction. The shared script
# reads the journal + SQL files actually packaged in this build context and
# fails the build when the tree is incomplete.
ARG GIT_SHA=unknown
ARG RELEASE_VERSION=unknown
RUN node packages/database/scripts/bake-migration-identity.js packages/database \
 && test -f packages/database/migration-identity.json || (echo "❌ migration-identity.json not generated!" && exit 1)

# Clean non-runtime source files and test suites from workspace packages
RUN find packages -type f \( -name "*.ts" -o -name "*.tsx" -o -name "*.mts" -o -name "*.cts" -o -name "*.md" -o -name "tsconfig*.json" \) -not -path "*/dist/*" -delete && \
    find packages -type d \( -name "src" -o -name "test" -o -name "tests" -o -name "__tests__" \) -exec rm -rf {} +

# ------------------------------------------------------------------------------
# Stage 3: Production Dependencies
# Install production-only dependencies without build tooling
# ------------------------------------------------------------------------------
FROM node:22-alpine AS prod-deps
RUN apk add --no-cache libc6-compat
WORKDIR /app
RUN corepack enable

COPY --from=pruner /app/out/json/ .
COPY --from=pruner /app/out/pnpm-lock.yaml ./pnpm-lock.yaml

RUN --mount=type=cache,id=pnpm,target=/root/.local/share/pnpm/store \
    pnpm install --prod

# ------------------------------------------------------------------------------
# Stage 4: Production Runner
# Minimal runtime environment with non-root security isolation
# ------------------------------------------------------------------------------
FROM node:22-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=4000

# Create non-root system user & group with fixed GID/UID 10001
RUN addgroup -S -g 10001 ananya && \
    adduser -S -u 10001 -G ananya -h /app ananya

# Copy pre-built production node_modules and built artifacts
COPY --from=prod-deps --chown=ananya:ananya /app/node_modules ./node_modules
COPY --from=builder --chown=ananya:ananya /app/packages ./packages
COPY --from=builder --chown=ananya:ananya /app/apps/api/dist ./apps/api/dist

# Deterministic build verification
RUN test -f apps/api/dist/src/main.js || (echo "❌ main.js not found in build output!" && exit 1) && \
    test -f packages/database/dist/setup/migrate.js || (echo "❌ migrate.js not found in build output!" && exit 1) && \
    test -d packages/database/drizzle || (echo "❌ drizzle migrations directory not found in build output!" && exit 1) && \
    test -f packages/database/migration-identity.json || (echo "❌ migration-identity.json not found in build output!" && exit 1)

USER ananya

EXPOSE 4000

# Health check probe
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://localhost:4000/health').then(r=>r.ok?process.exit(0):process.exit(1)).catch(()=>process.exit(1))"

CMD ["node", "apps/api/dist/src/main.js"]
