# ==============================================================================
# Ananya ERP — Production Web Container Image (Next.js Standalone)
# Hardened Multi-stage Dockerfile (Pruner -> Builder -> Prod-Deps -> Runner)
# ==============================================================================

# ------------------------------------------------------------------------------
# Stage 1: Pruner
# Prune the monorepo workspace for @ananya/web
# ------------------------------------------------------------------------------
FROM node:22-alpine AS pruner
RUN apk add --no-cache libc6-compat
WORKDIR /app
RUN corepack enable
COPY . .
RUN npx turbo prune --scope=@ananya/web --docker

# ------------------------------------------------------------------------------
# Stage 2: Builder
# Install dependencies and build production standalone Web artifacts
# ------------------------------------------------------------------------------
FROM node:22-alpine AS builder
RUN apk add --no-cache libc6-compat
WORKDIR /app
RUN corepack enable

COPY --from=pruner /app/out/json/ .
COPY --from=pruner /app/out/pnpm-lock.yaml ./pnpm-lock.yaml

RUN --mount=type=cache,id=pnpm,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile

COPY --from=pruner /app/out/full/ .

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

RUN pnpm turbo run build --filter=@ananya/web...

# ------------------------------------------------------------------------------
# Stage 3: Production Dependencies
# Kept for standard 4-stage pipeline structure across platform
# ------------------------------------------------------------------------------
FROM node:22-alpine AS prod-deps
RUN apk add --no-cache libc6-compat
WORKDIR /app
RUN corepack enable

COPY --from=pruner /app/out/json/ .
COPY --from=pruner /app/out/pnpm-lock.yaml ./pnpm-lock.yaml

RUN --mount=type=cache,id=pnpm,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile --prod

# ------------------------------------------------------------------------------
# Stage 4: Production Runner
# Minimal standalone Next.js runtime environment with non-root security isolation
# ------------------------------------------------------------------------------
FROM node:22-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"
ENV NEXT_TELEMETRY_DISABLED=1

# Create non-root system user & group with fixed GID/UID 10001
RUN addgroup -S -g 10001 ananya && \
    adduser -S -u 10001 -G ananya -h /app ananya

# Copy standalone output, static assets, and public files
COPY --from=builder --chown=ananya:ananya /app/apps/web/public ./apps/web/public
COPY --from=builder --chown=ananya:ananya /app/apps/web/.next/standalone ./
COPY --from=builder --chown=ananya:ananya /app/apps/web/.next/static ./apps/web/.next/static

# Copy entrypoint script
COPY --chown=ananya:ananya docker/entrypoint-web.sh /app/docker-entrypoint-web.sh
RUN chmod +x /app/docker-entrypoint-web.sh

USER ananya

EXPOSE 3000

# Health check probe
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://localhost:3000/api/health').then(r=>r.ok?process.exit(0):process.exit(1)).catch(()=>process.exit(1))"

ENTRYPOINT ["/app/docker-entrypoint-web.sh"]
CMD ["node", "apps/web/server.js"]
