# ==============================================================================
# Ananya ERP — Environment Configuration Template (.env.example)
# Copy this file to .env before deploying with Docker Compose or running locally.
# ==============================================================================

# ------------------------------------------------------------------------------
# Container Registry & Deployment Profiles
# ------------------------------------------------------------------------------
ANANYA_REGISTRY=ghcr.io/48studios
ANANYA_VERSION=latest

# Active Compose Profiles:
#   'all'    — runs complete production stack: API, Web, Worker, and ML (Recommended default)
#   'worker' — runs core stack and background worker without ML
#   'ml'     — runs core stack and ML service without background worker
#   'tools'  — includes pgAdmin for database management (e.g. COMPOSE_PROFILES=all,tools)
COMPOSE_PROFILES=all

# ------------------------------------------------------------------------------
# PostgreSQL Database Credentials
# Note: DATABASE_URL is constructed automatically by Docker Compose from these values.
# ------------------------------------------------------------------------------
POSTGRES_DB=ananya
POSTGRES_USER=ananya
POSTGRES_PASSWORD=ananya_secure_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ananya:ananya_secure_password@localhost:5432/ananya

# ------------------------------------------------------------------------------
# NestJS API Server Configuration
# ------------------------------------------------------------------------------
PORT=4000
API_PORT=4000
NODE_ENV=production
CORS_ORIGIN=http://localhost:3000
JWT_SECRET=ananya_jwt_production_secret_change_in_production

# ------------------------------------------------------------------------------
# Next.js Web Application Configuration
#
# API_PUBLIC_URL — the public base URL of the API that the browser calls directly.
#
# Deployment architecture:
#   https://erp.<domain>       → Next.js Web (port 3000)
#   https://api.erp.<domain>   → NestJS API  (port 4000)
#
# The browser communicates directly with the API at API_PUBLIC_URL.
# Docker service names (e.g. http://api:4000) must NEVER be used here.
#
# Development:  API_PUBLIC_URL=http://localhost:4000
# Production:   API_PUBLIC_URL=https://api.erp.example.com
# ------------------------------------------------------------------------------
WEB_PORT=3000
API_PUBLIC_URL=http://localhost:4000
NEXT_TELEMETRY_DISABLED=1

# ------------------------------------------------------------------------------
# Machine Learning Service Configuration (ananya-ml, CPU-first, Immich-style)
# ------------------------------------------------------------------------------
ML_PORT=5001
ML_SERVICE_URL=http://localhost:5001
ML_SERVICE_ENABLED=true

# ------------------------------------------------------------------------------
# Background Worker Service Configuration (Required when COMPOSE_PROFILES=worker)
# ------------------------------------------------------------------------------
WORKER_PORT=4001
WORKER_CONCURRENCY=5

# ------------------------------------------------------------------------------
# Persistent File Storage Configuration
# ------------------------------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=/app/uploads

# ------------------------------------------------------------------------------
# Development & Management Tools Configuration (Required when COMPOSE_PROFILES=tools)
# ------------------------------------------------------------------------------
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@ananya.internal
PGADMIN_DEFAULT_PASSWORD=admin_password
